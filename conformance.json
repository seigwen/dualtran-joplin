{
  "spec": "2.1.0",
  "host": "dualtran-joplin",
  "payload": "tests/conformance.test.ts",
  "payloadCommand": "sh scripts/conformance/emit-payload.sh",
  "static": {
    "files": ["src/settingsPanel.ts", "src/index.ts"],
    "patterns": [
      "providerSeparator",
      "__separator__",
      "__more__",
      "More (models.dev)",
      {
        "token": "provider-fallback-openai",
        "regex": "\\|\\|\\s*[\"']openai[\"']"
      },
      {
        "token": "provider-fallback-custom",
        "regex": "\\|\\|\\s*CUSTOM_PROVIDER"
      }
    ]
  },
  "platformLimits": []
}
