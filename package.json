{
  "name": "joplin-plugin-dualtran",
  "version": "0.1.5",
  "description": "DualTran for Joplin: translate a note into a separate note, keeping the source",
  "license": "MPL-2.0",
  "author": "seigwen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seigwen/dualtran-joplin.git"
  },
  "homepage": "https://github.com/seigwen/dualtran-joplin",
  "bugs": {
    "url": "https://github.com/seigwen/dualtran-joplin/issues"
  },
  "scripts": {
    "build": "node scripts/build-panel.js && joplin-plugin-cli build && node scripts/build-assets.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conformance": "node scripts/conformance/run.mjs",
    "e2e:panel": "node scripts/e2e/panel-smoke.mjs",
    "i18n": "node scripts/i18n-translate.mjs",
    "pack:publish": "node scripts/pack-publish.js",
    "release": "npm run build && npm run pack:publish",
    "verify": "npm run build && npm run typecheck && npm test && npm run conformance"
  },
  "keywords": [
    "joplin-plugin",
    "translation",
    "bilingual"
  ],
  "dependencies": {
    "joplin-plugin-api": "^0.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "joplin-plugin-cli": "0.1.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "publish",
    "README.md"
  ]
}
